{
  "manifest_version": 3,
  "name": "J7Tracker 中文界面",
  "short_name": "J7 中文",
  "version": "1.7.1",
  "description": "j7tracker.io 中文化、正文翻译、关键词工具与 Twitter 作者标签。支持用户备注编辑、导入导出及 Frontrun 更新。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "J7Tracker 中文扩展：在 j7tracker.io 页面右下角点「中」打开功能菜单",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://loadbalance.frontrun.pro/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://j7tracker.io/*",
        "https://*.j7tracker.io/*"
      ],
      "js": [
        "label-utils.js",
        "dict.js",
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*"
      ],
      "js": [
        "gmgn-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*"
      ],
      "js": [
        "gmgn.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "permissions": [
    "tabs",
    "storage",
    "cookies"
  ]
}
